source "https://rubygems.org"

# GitHub Pages builds this site with its own toolchain and ignores this file.
# It exists so the site can be built locally. The `github-pages` gem needs
# Ruby >= 2.7; these pins work on the system Ruby 2.6 on the author's Mac and
# match the Jekyll version GitHub Pages actually runs.
gem "jekyll", "~> 3.10.0"
gem "jekyll-feed"
gem "jekyll-seo-tag"
gem "jekyll-sitemap"
gem "jekyll-paginate"
gem "kramdown-parser-gfm"        # Jekyll 3 defaults to GFM input
gem "ffi", "< 1.17"              # 1.17+ requires Ruby >= 3.0
